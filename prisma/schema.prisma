generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Aluno {
  id    Int    @id @default(autoincrement())
  nome  String
  email String @unique

  @@map("alunos")
}

model Curso {
  id     Int    @id @default(autoincrement())
  titulo String

  @@map("cursos")
}
